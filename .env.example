# Copia este archivo como ".env" (mismo directorio) y ajusta las rutas si tu
# instalación no usa D:\MEDIA. No subas el ".env" real a ningún backup público:
# aunque no lleva contraseñas, si expones el stack a Internet no conviene
# publicar rutas/host internos.

# Raíz de datos (torrents + biblioteca). Estructura esperada dentro:
#   DATA_ROOT/torrents/movies  DATA_ROOT/torrents/tv
#   DATA_ROOT/media/movies     DATA_ROOT/media/tv
DATA_ROOT=D:/MEDIA/data

# Raíz de configuración de cada servicio (una subcarpeta por servicio).
CONFIG_ROOT=D:/MEDIA/config

# Destino de los backups automáticos (servicio "backup", corre solo cada
# BACKUP_INTERVAL_HOURS). Copia ahí ${CONFIG_ROOT} completo + .env — lo
# único que no se puede reconstruir con "git clone" (docker-compose.yml/
# bootstrap/scripts ya están en el repo, no hace falta duplicarlos aquí).
# No contiene bibliotecas multimedia (esas no hace falta respaldarlas, ver
# README sección 8).
#
# IMPORTANTE: el ejemplo de abajo usa D:, el mismo disco que DATA_ROOT/
# CONFIG_ROOT a propósito de ejemplo -- pero si tu instalación real usa un
# único disco, un backup ahí NO protege de nada (si el disco muere, se
# pierden origen y copia a la vez). Para que este backup tenga sentido de
# verdad, señala una unidad FÍSICA distinta (otro disco interno, un USB
# permanente, una carpeta de red) o un servicio de sync en la nube que
# vigile esa carpeta.
BACKUP_ROOT=D:/MEDIA/backup

# Cada cuántas horas corre el backup automático. 24 (una vez al día) es un
# punto de partida razonable para configs que no cambian cada minuto.
BACKUP_INTERVAL_HOURS=24

# Cada cuántas horas se vuelve a medir el disco para la página "Espacio en
# disco" del panel (también se puede forzar desde la propia página). Medir
# es barato (unos segundos), así que 1 está bien.
DISK_REPORT_INTERVAL_HOURS=1

# Si una descarga termina pero Radarr/Sonarr no la meten en la biblioteca
# ("Manual Import required"), la página "Espacio en disco" la importa sola
# cuando no hay ninguna duda de qué es. Pon false para hacerlo siempre tú
# con el botón "Importar".
DISK_REPORT_AUTO_IMPORT=true

# Si en el disco de datos quedan menos de estos GB libres, las descargas de
# qBittorrent se paran solas (lo que está compartiendo sigue igual) y se
# reanudan cuando vuelve a haber 20 GB más. Con el disco lleno Jellyfin deja
# de poder reproducir y qBittorrent se queda roto.
DISK_MIN_FREE_GB=50

# Horas sin avanzar (sin fuentes) para que una descarga aparezca como
# "atascada" en la página "Espacio en disco", con un botón para descartarla
# y que Radarr/Sonarr busquen otra versión.
STALLED_HOURS=6

# Días desde que se vio algo en Jellyfin para que salga en "Ya visto" de la
# página "Espacio en disco", con un botón para borrarlo (nunca se borra solo).
WATCHED_DAYS=30

# Usuario/grupo con el que corren los procesos dentro de los contenedores
# LinuxServer.io. En Windows + Docker Desktop/WSL2 importa menos que en Linux
# nativo (el bind mount NTFS no respeta permisos Unix reales), pero se deja
# por compatibilidad. No lo cambies salvo que sepas por qué.
PUID=1000
PGID=1000

TZ=Europe/Madrid

# IP LAN del PC que ejecuta Docker Desktop. Se usa para los enlaces que
# genera el panel/Homer (localhost no sirve si abres el panel desde el móvil
# o la tele). Recomendado: fija una reserva DHCP para esta IP en tu router
# para que no cambie.
HOST_LAN_IP=192.168.1.100

# Opcional: solo hace falta si quieres que Radarr/Sonarr avisen a Jellyfin
# en cuanto importan algo nuevo (en vez de depender solo de su
# monitorización en tiempo real, poco fiable vía WSL2 -- ver
# CONFIGURACION-MANUAL.md paso 2c). La API key no existe hasta que
# completas el asistente inicial de Jellyfin. Déjala vacía y no pasa nada;
# rellénala y vuelve a lanzar bootstrap (p.ej.
# "docker compose run --rm recyclarr sync") para que se aplique.
JELLYFIN_API_KEY=
